{
  "schema": 1,
  "control_protocol": 2,
  "storage_schema": 3,
  "partners": [
    "codex",
    "deepseek",
    "qwen",
    "claude",
    "grok",
    "gemini",
    "kimi",
    "glm"
  ],
  "routes": [
    "account",
    "api"
  ],
  "api_driver_provider": "deepseek",
  "api_driver_provider_compatibility": "LEGACY_STAGE2_VERIFICATION_PROVIDER; NEW_RUNS_USE_EXACT_API_PROVIDER",
  "api_providers": ["openai", "deepseek", "qwen", "anthropic", "xai", "gemini", "kimi", "glm"],
  "api_catalog": {
    "path": "src/researchos/workdesk/partners/api_providers.json",
    "schema": 1,
    "source": "FROZEN_IMPLEMENTATION; SHA256_AND_PROVIDER_SNAPSHOT_BOUND_TO_RUN",
    "compatibility": "PER_PARTNER_AND_PROVIDER; ISOLATED_COMBINATIONS_REJECTED_BEFORE_DISPATCH; NO_FALLBACK",
    "credentials": "kind=api; api_provider=EXACT_VENDOR; LEGACY_kind=deepseek_api_RETAINS_IDS_AND_VERIFICATION",
    "key_fanout": "EXPLICIT; SAME_API_PROVIDER_ONLY",
    "verification": "EXACT_PROVIDER_ACCOUNT_SECRET_VERSION_AND_CONNECTION; LEGACY_api_verification_REMAINS_DEEPSEEK"
  },
  "credentials": "REFERENCES_ONLY; USER_SUPPLIED_AT_FINAL_VERIFICATION",
  "commands": [
    "component.prepare",
    "component.update",
    "component.disable",
    "component.remove",
    "account.create",
    "account.set-key",
    "account.login",
    "account.inspect",
    "account.login-input",
    "account.disconnect",
    "connection.save",
    "connection.disable",
    "connection.inspect",
    "partner.run",
    "partner.input",
    "partner.approve",
    "partner.stop",
    "component.enable",
    "component.reconcile",
    "partner.reconcile"
  ],
  "reads": [
    "/api/v2/partners",
    "/api/v2/components",
    "/api/v2/accounts",
    "/api/v2/connections",
    "/api/v2/component-operations",
    "/api/v2/partner-runs",
    "/api/v2/partner-runs/{id}",
    "/api/v2/partner-runs/{id}/events?after={seq}",
    "/api/v1/connection-setup",
    "/api/v1/settings-usage?days={days}",
    "/api/v1/settings-token-usage?partner_id={partner}&api_provider={vendor}&account_id={account}&route={route}&days={days}&page={page}"
  ],
  "worker": {
    "transport": "inherited-json-lines",
    "module": "researchos.workdesk.partners",
    "initialize": {
      "action": "start",
      "config": "frozen-runtime-binding"
    },
    "controls": [
      "input",
      "login-input",
      "approval",
      "stop"
    ]
  },
  "unknown_no_resend": true,
  "native_execution": "OFFICIAL_AGENT; NO_REPLACEMENT_LOOP",
  "official_auth": "HUMAN_MANAGED; NO_ACCOUNT_SWITCH_OR_RESET",
  "component_removal": "MANAGED_EXACT_RELEASE_ONLY; REFERENCES_CHECKED; USER_DATA_RETAINED",
  "unified_work_record": "partner_run; SAME_RUN_ID; MODE_RUN_ONLY; PROJECT_AND_NATIVE_USAGE_BOUND",
  "run_admission": "OPTIONAL_CONNECTION_REVISION_MUST_MATCH_WHEN_SUPPLIED; FREEZE_CURRENT_BINDING",
  "reconcile_resolutions": {
    "accept_received_result": "EXPLICIT; CONFIRMED_LOCAL_EXIT; SAVED_MATCHING_OFFICIAL_NATIVE_TURN; NO_STOP_INTENT; NO_RESEND",
    "close_local_tracking": "EXPLICIT; CONFIRMED_LOCAL_EXIT; REMOTE_OUTCOME_REMAINS_UNKNOWN"
  },
  "request_intent_count": "OBSERVED_GATEWAY_INTENTS; NOT_BILLING_COUNT",
  "usage": {
    "source": "SAME_PARTNER_RUN_AND_EVENTS; READ_ONLY; MODE_RUN_ONLY",
    "identity": "partner_id; api_provider; account_id; route; run_id; request_id_WHEN_REPORTED",
    "deduplication": "REQUEST_RECEIPTS_FIRST; NO_ADDITION_OF_NATIVE_TOTALS_TO_REQUEST_RECEIPTS",
    "missing": "NULL_IS_UNKNOWN; ZERO_ONLY_WHEN_REPORTED; PARTIAL_USAGE_LABELLED",
    "price": "ACTUAL_API_PROVIDER_AND_ROUTE; ACCOUNT_SUBSCRIPTIONS_NEVER_USE_API_TARIFFS",
    "quota": "NATIVE_ACCOUNT_QUOTA_UNKNOWN_UNLESS_OFFICIALLY_REPORTED; LEGACY_QUOTA_STAYS_LEGACY"
  },
  "connection_launcher": "ORIGINAL_connect_FULL_PAGE; SAME_VERSIONED_WORK_AND_API_RECORDS; WEBSITE_CHAT_CONFIRMATIONS_INDEPENDENT",
  "business_projection": "workspace.partner_connections; EXACT_CONNECTION_ACCOUNT_RELEASE_API_AND_MODEL; PER_CONNECTION_MEMBERS; LEGACY_RECORDS_RETAIN_THEIR_ORIGINAL_ROUTE",
  "permission_catalog": {
    "path": "src/researchos/workdesk/partners/permissions.json",
    "binding": "resolved_permission={partner_id,value,native,catalog_sha256}; permission_source_FROZEN_AT_ADMISSION",
    "defaults": "EIGHT_PARTNERS; OLD_THREE_PREFERENCES_PRESERVED; SUPPORTED_NATIVE_MODES_ONLY",
    "full_access": "EXPLICIT_PER_WORK_CONFIRMATION; NEVER_INFERRED_FROM_AUTO",
    "configuration_revision": "VERIFICATION_OBSERVATIONS_DO_NOT_CHANGE_CONNECTION_CONFIGURATION_REVISION"
  },
  "native_feature_catalog": {
    "path": "src/researchos/workdesk/partners/native_features.json",
    "binding": "EXACT_MANAGED_RELEASE_ID_VERSION_AND_ROUTE; OPTIONAL_API_PROVIDER_OR_PERMISSION_SCOPE",
    "continuation": "OFFICIAL_RESUME_METHOD_AND_INDEPENDENT_AUTOMATIC_CONTINUATION_GATE",
    "mcp": "DISTINCT_SCOPED_TRANSPORT_FACT; CONFIGURATION_DOES_NOT_IMPLY_SERVER_CONNECTED"
  },
  "partner_task_bridge": {
    "transport": "PRIVATE_OWNER_EPOCH_BOUND_RPC_AFTER_PARENT_TRANSACTION_COMMIT",
    "methods": ["partner.task.start", "partner.task.poll", "partner.task.stop"],
    "binding": "EXACT_TASK_ATTEMPT_SPEC_HASH_CONNECTION_REVISION_ACCOUNT_CREDENTIAL_GENERATION_RELEASE_WORKSPACE",
    "admission": "ONE_RUN_PER_PARENT_ATTEMPT; SAME_COMMAND_ID; UNKNOWN_REUSES_ORIGINAL_RUN; NO_REPLACEMENT_DISPATCH",
    "relationship": "parent_task_id; parent_attempt_id; parent_spec_hash; ORIGINAL_RUN_RESULT_AND_SESSION",
    "accounting": "ORIGINAL_CHILD_RECEIPTS_ONCE; PARENT_MIRRORS_EXCLUDED; UNKNOWN_COST_NOT_ZERO",
    "continuation": "UNVERIFIED_ORIGINAL_SESSION_RESUME_AND_PER_TASK_MCP_COMBINATIONS_EXPLICITLY_UNAVAILABLE"
  },
  "official_account_state": {
    "auth_state": ["AUTHENTICATED", "UNAUTHENTICATED", "UNKNOWN"],
    "login_attempt": "login_run_id; login_state; login_release_id; SEPARATE_FROM_AUTHENTICATION_FACT",
    "unknown_observation": "DOES_NOT_REVOKE_EXISTING_AUTHENTICATION",
    "inspect_active_login": "SAME_ACCOUNT_AND_RELEASE_REUSES_ORIGINAL_LOGIN_RUN; NO_NEW_PROCESS",
    "login_options": "PARTNER_SPECIFIC_ALLOWLIST; SAVED_AFTER_ADMISSION_AND_FROZEN_WITH_RUN",
    "sensitive_login_input": "EXACT_PENDING_REQUEST; TRANSIENT_STDIN_ONLY; NO_TEXT_OR_TEXT_DIGEST_IN_LEDGER; NO_ORDINARY_INPUT_FALLBACK"
  }
}
