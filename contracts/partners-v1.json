{
  "schema": 1,
  "control_protocol": 2,
  "storage_schema": 3,
  "partners": [
    "codex",
    "deepseek",
    "qwen",
    "claude",
    "grok",
    "gemini",
    "kimi",
    "glm"
  ],
  "routes": [
    "account",
    "api"
