  "api_providers": ["openai", "deepseek", "qwen", "anthropic", "xai", "gemini", "kimi", "glm"],
  "api_catalog": {
    "path": "src/researchos/workdesk/partners/api_providers.json",
    "schema": 1,
    "source": "FROZEN_IMPLEMENTATION; SHA256_AND_PROVIDER_SNAPSHOT_BOUND_TO_RUN",
    "compatibility": "PER_PARTNER_AND_PROVIDER; ISOLATED_COMBINATIONS_REJECTED_BEFORE_DISPATCH; NO_FALLBACK",
    "credentials": "kind=api; api_provider=EXACT_VENDOR; LEGACY_kind=deepseek_api_RETAINS_IDS_AND_VERIFICATION",
    "key_fanout": "EXPLICIT; SAME_API_PROVIDER_ONLY",
    "verification": "EXACT_PROVIDER_ACCOUNT_SECRET_VERSION_AND_CONNECTION; LEGACY_api_verification_REMAINS_DEEPSEEK"
  },
  "credentials": "REFERENCES_ONLY; USER_SUPPLIED_AT_FINAL_VERIFICATION",
  "commands": [
    "component.prepare",
    "component.update",
    "component.disable",
    "component.remove",
    "account.create",
    "account.set-key",
    "account.login",
    "account.inspect",
    "account.login-input",
    "account.disconnect",
    "connection.save",
    "connection.disable",
    "connection.inspect",
    "partner.run",
    "partner.input",
    "partner.approve",
    "partner.stop",
    "component.enable",
    "component.reconcile",
    "partner.reconcile"
