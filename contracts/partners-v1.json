  "reads": [
    "/api/v2/partners",
    "/api/v2/components",
    "/api/v2/accounts",
    "/api/v2/connections",
    "/api/v2/component-operations",
    "/api/v2/partner-runs",
    "/api/v2/partner-runs/{id}",
    "/api/v2/partner-runs/{id}/events?after={seq}",
    "/api/v1/connection-setup",
    "/api/v1/settings-usage?days={days}",
    "/api/v1/settings-token-usage?partner_id={partner}&api_provider={vendor}&account_id={account}&route={route}&days={days}&page={page}"
  ],
  "worker": {
    "transport": "inherited-json-lines",
    "module": "researchos.workdesk.partners",
    "initialize": {
      "action": "start",
      "config": "frozen-runtime-binding"
    },
    "controls": [
      "input",
      "login-input",
      "approval",
      "stop"
    ]
  },
  "unknown_no_resend": true,
  "native_execution": "OFFICIAL_AGENT; NO_REPLACEMENT_LOOP",
  "official_auth": "HUMAN_MANAGED; NO_ACCOUNT_SWITCH_OR_RESET",
  "component_removal": "MANAGED_EXACT_RELEASE_ONLY; REFERENCES_CHECKED; USER_DATA_RETAINED",
  "unified_work_record": "partner_run; SAME_RUN_ID; MODE_RUN_ONLY; PROJECT_AND_NATIVE_USAGE_BOUND",
  "run_admission": "OPTIONAL_CONNECTION_REVISION_MUST_MATCH_WHEN_SUPPLIED; FREEZE_CURRENT_BINDING",
  "reconcile_resolutions": {
    "accept_received_result": "EXPLICIT; CONFIRMED_LOCAL_EXIT; SAVED_MATCHING_OFFICIAL_NATIVE_TURN; NO_STOP_INTENT; NO_RESEND",
    "close_local_tracking": "EXPLICIT; CONFIRMED_LOCAL_EXIT; REMOTE_OUTCOME_REMAINS_UNKNOWN"
  },
  "request_intent_count": "OBSERVED_GATEWAY_INTENTS; NOT_BILLING_COUNT",
  "usage": {
    "source": "SAME_PARTNER_RUN_AND_EVENTS; READ_ONLY; MODE_RUN_ONLY",
    "identity": "partner_id; api_provider; account_id; route; run_id; request_id_WHEN_REPORTED",
    "deduplication": "REQUEST_RECEIPTS_FIRST; NO_ADDITION_OF_NATIVE_TOTALS_TO_REQUEST_RECEIPTS",
    "missing": "NULL_IS_UNKNOWN; ZERO_ONLY_WHEN_REPORTED; PARTIAL_USAGE_LABELLED",
    "price": "ACTUAL_API_PROVIDER_AND_ROUTE; ACCOUNT_SUBSCRIPTIONS_NEVER_USE_API_TARIFFS",
    "quota": "NATIVE_ACCOUNT_QUOTA_UNKNOWN_UNLESS_OFFICIALLY_REPORTED; LEGACY_QUOTA_STAYS_LEGACY"
  },
  "connection_launcher": "ORIGINAL_connect_FULL_PAGE; SAME_VERSIONED_WORK_AND_API_RECORDS; WEBSITE_CHAT_CONFIRMATIONS_INDEPENDENT",
  "official_account_state": {
    "auth_state": ["AUTHENTICATED", "UNAUTHENTICATED", "UNKNOWN"],
    "login_attempt": "login_run_id; login_state; login_release_id; SEPARATE_FROM_AUTHENTICATION_FACT",
    "unknown_observation": "DOES_NOT_REVOKE_EXISTING_AUTHENTICATION",
    "inspect_active_login": "SAME_ACCOUNT_AND_RELEASE_REUSES_ORIGINAL_LOGIN_RUN; NO_NEW_PROCESS",
    "login_options": "PARTNER_SPECIFIC_ALLOWLIST; SAVED_AFTER_ADMISSION_AND_FROZEN_WITH_RUN",
    "sensitive_login_input": "EXACT_PENDING_REQUEST; TRANSIENT_STDIN_ONLY; NO_TEXT_OR_TEXT_DIGEST_IN_LEDGER; NO_ORDINARY_INPUT_FALLBACK"
  }
}
