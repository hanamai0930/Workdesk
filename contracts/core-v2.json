    "materials":"/api/v2/projects/{project_id}/materials","export":"/api/v2/projects/{project_id}/export?version={url_encoded_version_json}","export_selection":"repeat version for up to 32 files; 64 MiB total; ZIP with manifest.json",
    "artifact":"/api/v2/jobs/{id}/artifact?path={path}&download=1","model_requests":0
  },
  "computer_tool": {
